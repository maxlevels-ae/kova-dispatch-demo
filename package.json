{
  "name": "maxride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "start:next": "next start",
    "lint": "eslint",
    "seed": "node scripts/seed.js",
    "docker:build": "docker build -t kova .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local kova",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "sim:driver": "node scripts/simulate-driver.js",
    "test": "node --experimental-default-type=module --experimental-loader ./tests/loader.mjs --test tests/regression.test.mjs tests/settings.test.mjs tests/notifications.test.mjs",
    "audit:currency": "node scripts/financial-inventory.mjs",
    "test:http": "node tests/http-smoke.mjs",
    "test:integration": "node --experimental-default-type=module --experimental-loader ./tests/loader.mjs tests/integration.mjs",
    "test:staging": "node --env-file=.env.staging.qa tests/staging-browser.mjs",
    "test:staging-config": "node --test tests/staging-config.test.mjs",
    "validate:staging": "node scripts/validate-staging-blueprint.mjs",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "predev": "node scripts/prepare-map-worker.mjs",
    "predev:next": "node scripts/prepare-map-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1054.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.40.0",
    "h3-js": "^4.4.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "6.16.0",
    "mongoose": "^9.6.2",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.5.0",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "js-yaml": "^5.5.0",
    "typescript": "5.9"
  }
}
